# =============================================================================
# Cardmarket Companion - environment configuration
# Copy to .env and adjust. NEVER commit real secrets (.env is git-ignored).
#
#   development: docker compose up            (placeholders below are fine)
#   production : docker compose -f docker-compose.prod.yml up -d
#                -> every variable marked [PROD REQUIRED] must be set with real
#                   random values; the prod file has NO defaults for secrets and
#                   the API refuses to start with these placeholders.
# Generate secrets:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- general -------------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | console

# --- database ------------------------------------------------------------------
POSTGRES_USER=cmc
# [PROD REQUIRED] URL-safe characters only (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cmc
# The API builds DATABASE_URL from the values above in docker-compose.
# Outside compose:
# DATABASE_URL=postgresql+psycopg://cmc:password@localhost:5432/cmc

# --- web sessions / security ----------------------------------------------------
# Development only (plain http). Forced to true by docker-compose.prod.yml.
COOKIE_SECURE=false
# COOKIE_DOMAIN=companion.example.com
# SESSION_TTL_HOURS=336
# LOGIN_RATE_LIMIT_ATTEMPTS=8
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# MESSAGE_RATE_LIMIT_PER_MINUTE=20

# --- first run -------------------------------------------------------------------
# Development: the web wizard (/setup) creates the administrator.
# Production: the wizard is DISABLED unless SETUP_TOKEN is set (then it asks for it).
# Recommended in production: leave SETUP_TOKEN empty and run
#   docker compose -f docker-compose.prod.yml exec api python -m app.scripts.create_admin --email you@shop.it
SETUP_TOKEN=
# Development only; forced to false in production (run the seed once by hand).
SEED_ON_START=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- agent <-> API -----------------------------------------------------------------
# [PROD REQUIRED] Shared secret for /internal/agent/*, >= 32 random chars.
AGENT_API_TOKEN=dev-only-agent-token-change-me-0123456789
AGENT_ID=agent-main

# --- Cardmarket ----------------------------------------------------------------------
# [PROD REQUIRED - explicit] true  = simulated marketplace (no Cardmarket account)
#                            false = real browser agent (requires pairing)
MOCK_CARDMARKET=true
SYNC_INTERVAL_SECONDS=45
CARDMARKET_LANGUAGE=it
CARDMARKET_GAME=Magic

# Mock only
MOCK_AUTO_PAIR=true
MOCK_ACTIVITY_RATE=0.35

# Browser agent (live mode)
AGENT_HEADLESS=true
TRACE_ON_FAILURE=false
# Keeps raw HTML of parsed pages in artifacts: development only, contains customer data.
DEBUG_CAPTURE_HTML=false

# Manual pairing viewer (noVNC). Bound to 127.0.0.1 by compose; reach it via SSH tunnel.
PAIRING_VNC_ENABLED=false
# [PROD REQUIRED] even when the viewer is disabled (VNC uses at most 8 characters).
PAIRING_VNC_PASSWORD=
PAIRING_VNC_PORT=6080
# Link shown in the admin UI during pairing
PAIRING_VIEWER_URL=http://localhost:6080/vnc.html

# --- web push (VAPID) --------------------------------------------------------------------
# Generate: docker compose run --rm api python -m app.scripts.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- privacy / retention -------------------------------------------------------------------
RETENTION_MESSAGES_DAYS=365
# RETENTION_NOTIFICATIONS_DAYS=60
# RETENTION_AUDIT_DAYS=365
# RETENTION_SYNC_RUNS_DAYS=30

# --- ports -------------------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000

# --- production reverse proxy (docker-compose.prod.yml) ------------------------------------------
# [PROD REQUIRED]
DOMAIN=companion.example.com
ACME_EMAIL=admin@example.com
# Host ports published by Caddy (the only published ports in production)
HTTP_PORT=80
HTTPS_PORT=443
