# =============================================================================
# Cardmarket Companion - environment configuration
# Copy to .env and adjust. NEVER commit real secrets. Defaults = local mock mode.
# =============================================================================

# --- general -------------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | console

# --- database ------------------------------------------------------------------
POSTGRES_USER=cmc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cmc
# The API builds DATABASE_URL from the values above in docker-compose.
# Outside compose:
# DATABASE_URL=postgresql+psycopg://cmc:password@localhost:5432/cmc

# --- web sessions / security ----------------------------------------------------
# true in production (HTTPS). false only for plain-http local development.
COOKIE_SECURE=false
# COOKIE_DOMAIN=companion.example.com
# SESSION_TTL_HOURS=336
# LOGIN_RATE_LIMIT_ATTEMPTS=8
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# MESSAGE_RATE_LIMIT_PER_MINUTE=20

# --- first run -------------------------------------------------------------------
# Leave empty to create the administrator from the web wizard (/setup).
SEED_ON_START=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- agent <-> API -----------------------------------------------------------------
# Shared secret for /internal/agent/*. Production requires >= 32 random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_API_TOKEN=dev-only-agent-token-change-me-0123456789
AGENT_ID=agent-main

# --- Cardmarket ----------------------------------------------------------------------
# true  = simulated marketplace (no Cardmarket account needed)
# false = real browser agent on www.cardmarket.com (requires pairing)
MOCK_CARDMARKET=true
SYNC_INTERVAL_SECONDS=45
CARDMARKET_LANGUAGE=it
CARDMARKET_GAME=Magic

# Mock only
MOCK_AUTO_PAIR=true
MOCK_ACTIVITY_RATE=0.35

# Browser agent (live mode)
AGENT_HEADLESS=true
TRACE_ON_FAILURE=false
# Keeps raw HTML of parsed pages in artifacts: development only, contains customer data.
DEBUG_CAPTURE_HTML=false

# Manual pairing viewer (noVNC). Bound to 127.0.0.1 by compose; reach it via SSH tunnel.
PAIRING_VNC_ENABLED=false
PAIRING_VNC_PASSWORD=
PAIRING_VNC_PORT=6080
# Link shown in the admin UI during pairing
PAIRING_VIEWER_URL=http://localhost:6080/vnc.html

# --- web push (VAPID) --------------------------------------------------------------------
# Generate: docker compose run --rm api python -m app.scripts.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- privacy / retention -------------------------------------------------------------------
RETENTION_MESSAGES_DAYS=365
# RETENTION_NOTIFICATIONS_DAYS=60
# RETENTION_AUDIT_DAYS=365
# RETENTION_SYNC_RUNS_DAYS=30

# --- ports -------------------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000

# --- production reverse proxy (docker-compose.prod.yml) ------------------------------------------
# DOMAIN=companion.example.com
# ACME_EMAIL=admin@example.com
